# Lumira environment variables — document every variable here (docs/agents/recipes/add-env-variable.md).
# Copy to .env.local and fill in real values locally; never commit real values.
# Only NEXT_PUBLIC_* values are visible in the browser. Secrets must never use that prefix.

# Public base URL of the site, used for canonical URLs and sitemaps.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
